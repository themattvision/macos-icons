          "stringUnit": {
            "state": "new",
            "value": "Il servizio a monte del tuo Worker ha esaurito le %1$lld ricerche mensili. %2$@ Controlla la configurazione o il piano del servizio usato dal Worker."
          }
        }
      }
    },
