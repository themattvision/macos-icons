    "Inserisci un termine di ricerca valido.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a valid search term."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Introduce un término de búsqueda válido."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Masukkan istilah pencarian yang valid."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効な検索語を入力してください。"
          }
        }
      }
    },
    "L'URL di questo formato non e' valido.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "This format's URL isn't valid."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La URL de este formato no es válida."
          }
        },
        "id": {
