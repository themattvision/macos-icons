          }
        }
      }
    },
    "L'app che scegli diventa il bersaglio a cui applicherai la prossima icona.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The app you choose becomes the target for the next icon you apply."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La app que elijas se convierte en el objetivo al que aplicarás el próximo icono."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Aplikasi yang dipilih akan menjadi sasaran penerapan ikon berikutnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "選んだアプリケーションが、次のアイコンを適用する対象になります。"
          }
        }
      }
    },
    "La API key non è valida o è scaduta: aggiornala dalle Impostazioni (Cmd+,).": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The API key is invalid or expired. Update it in Settings (Cmd+,)."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave de API no es válida o ha caducado: actualízala en los Ajustes (Cmd+,)."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci API tidak valid atau sudah kedaluwarsa: perbarui di Pengaturan (Cmd+,)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "APIキーが無効か期限切れです。設定（⌘,）から更新してください。"
          }
        }
      }
    },
    "La chiave è personale, si ottiene gratuitamente dalla dashboard sviluppatori di macOSicons e resta salvata solo su questo Mac.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The key is personal. Get one for free from the macOSicons developer dashboard; it's stored only on this Mac."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "La clave es personal: se obtiene gratis en el panel de desarrolladores de macOSicons y se guarda solo en este Mac."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Kunci ini bersifat pribadi, diperoleh secara gratis dari dasbor pengembang macOSicons, dan hanya tersimpan di Mac ini."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このキーは個人用のもので、macOSiconsの開発者向けダッシュボードから無料で取得でき、このMacにのみ保存されます。"
          }
        }
      }
    },
