        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Il Worker ci ha messo troppo a rispondere e la richiesta è stata interrotta. Di solito basta riprovare."
          }
        }
      }
    },
    "Il Worker ha rifiutato il token: aggiornalo dalle Impostazioni (Cmd+,).": {
      "localizations": {
