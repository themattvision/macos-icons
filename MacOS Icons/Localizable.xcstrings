    "Il tuo Worker è temporaneamente irraggiungibile. Controlla rete e deploy, poi riprova.": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Worker is temporarily unavailable. Check the network and deployment, then try again."
          }
        },
