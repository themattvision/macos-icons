    "Nessuna icona trovata per \"%@\". Prova con un altro nome.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "No icons found for \"%@\". Try another name."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha encontrado ningún icono para “%@”. Prueba con otro nombre."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak ada ikon yang ditemukan untuk \"%@\". Coba nama lain."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」に一致するアイコンが見つかりませんでした。別の名前でお試しください。"
          }
        }
      }
    },
    "Non sono riuscito a cambiare l'icona di \"%@\". Riprova; se il problema continua, prova a chiudere l'app prima di riapplicare l'icona.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't change the icon for \"%@\". Try again; if the problem persists, try quitting the app before reapplying the icon."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido cambiar el icono de “%@”. Vuelve a intentarlo; si el problema continúa, prueba a cerrar la app antes de volver a aplicar el icono."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Tidak berhasil mengubah ikon \"%@\". Coba lagi; jika masalah masih berlanjut, coba tutup aplikasi itu sebelum menerapkan ulang ikonnya."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」のアイコンを変更できませんでした。もう一度お試しください。問題が解決しない場合は、アプリを終了してからアイコンを再適用してみてください。"
          }
        }
      }
    },
    "Non sono riuscito a scaricare questa icona. Controlla la connessione e riprova.": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't download this icon. Check your connection and try again."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se ha podido descargar este icono. Comprueba la conexión y vuelve a intentarlo."
          }
        },
        "id": {
          "stringUnit": {
            "state": "translated",
            "value": "Ikon ini tidak berhasil diunduh. Periksa koneksi dan coba lagi."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このアイコンをダウンロードできませんでした。接続を確認してもう一度お試しください。"
          }
        }
      }
    },
